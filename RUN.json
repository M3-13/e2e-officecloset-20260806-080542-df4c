{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": [
        "${python}", "-m", "uvicorn", "main:app",
        "--host", "0.0.0.0", "--port", "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "env": {
        "DATABASE_PATH": {
          "dev": "wardrobe.db"
        },
        "JWT_SECRET_KEY": {
          "generate": "hex",
          "bytes": 32
        },
        "UPLOAD_DIR": {
          "dev": "uploads"
        },
        "FRONTEND_ORIGIN": {
          "dev": "http://localhost:5173"
        }
      }
    }
  ]
}
