{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "start": [
        "${python}", "-m", "uvicorn", "main:app",
        "--host", "0.0.0.0", "--port", "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "env": {
        "DATABASE_PATH": {
          "dev": "wardrobe.db"
        },
        "JWT_SECRET_KEY": {
          "generate": "hex",
          "bytes": 32
        },
        "UPLOAD_DIR": {
          "dev": "uploads"
        },
        "FRONTEND_ORIGIN": {
          "dev": "${service:frontend.origin}"
        }
      }
    },
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "static",
      "install": [
        ["npm", "ci"]
      ],
      "build": [
        ["npm", "run", "build"]
      ],
      "serve_dir": "dist",
      "start": ["npx", "vite", "preview", "--port", "${PORT}", "--host", "0.0.0.0"],
      "port": 4173,
      "port_env": "PORT"
    }
  ]
}
