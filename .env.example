# Environment Variables — Red Carpet Wardrobe
# Copy this to .env (or set in your shell / RUN.json) and fill in the values.

# Path to the SQLite database file (dev default: wardrobe.db)
DATABASE_PATH=wardrobe.db

# Secret key for JWT signing — generate a strong random value (min 32 chars)
# RUN.json auto-generates this per run. For manual dev, set your own:
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-characters

# Directory for uploaded clothing images (dev default: uploads)
UPLOAD_DIR=uploads

# Allowed CORS origin for the frontend (dev default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
